# =================================================================
# VeloGo Platform Environment Configuration Blueprint
# Copy this file to .env and adjust variables as needed.
# =================================================================

# Server & Profile Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Allowed CORS Origins (Comma-separated in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# Database Configuration (PostgreSQL in production, H2 embedded in local dev)
DB_URL=jdbc:postgresql://localhost:5432/velogodb
DB_USER=velogo_user
DB_PASSWORD=your_secure_db_password_here

# Redis Cache & PubSub (Used in production clustering)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security (Must be at least 256-bit / 32 characters in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Razorpay Payment Gateway (Test Mode / Production)
# Set PAYMENT_SIMULATE_MODE=true for local zero-dependency testing without live API keys
# Set PAYMENT_SIMULATE_MODE=false for real Razorpay transactions with validated signatures
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
PAYMENT_SIMULATE_MODE=true

# Geospatial Routing & Geocoding Providers
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Dispatch Engine Parameters
DISPATCH_MATCHING_RADIUS_KM=15.0
DISPATCH_REQUEST_TIMEOUT_SECONDS=45

# Frontend Build Variables (Used during vite build)
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
